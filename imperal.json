{
  "manifest_schema_version": 3,
  "sdk_version": "5.9.1",
  "app_id": "proxmox-connector",
  "version": "0.4.0",
  "name": "Proxmox Connector",
  "description": "Connect your own Proxmox VE and manage nodes, storage, VMs, containers, snapshots, clones, and tasks from Imperal.",
  "icon": "icon.svg",
  "actions_explicit": true,
  "system": false,
  "capabilities": [
    "store:read",
    "store:write",
    "secrets:read",
    "secrets:write"
  ],
  "tools": [
    {
      "name": "connect_proxmox",
      "description": "Connect a user's Proxmox VE host or cluster using API token or username/password and save the connection for future actions.",
      "action_type": "write",
      "chain_callable": true,
      "effects": [
        "create:connection"
      ],
      "id_projection": "",
      "params_schema": {
        "type": "object",
        "title": "ConnectProxmoxParams",
        "properties": {
          "base_url": {
            "type": "string"
          },
          "auth_mode": {
            "type": "string",
            "enum": [
              "api_token",
              "password"
            ]
          },
          "realm": {
            "type": "string",
            "default": "pam"
          },
          "username": {
            "type": "string"
          },
          "password": {
            "type": "string",
            "default": ""
          },
          "token_id": {
            "type": "string",
            "default": ""
          },
          "token_secret": {
            "type": "string",
            "default": ""
          },
          "tls_verify": {
            "type": "boolean",
            "default": true
          },
          "label": {
            "type": "string",
            "default": ""
          }
        },
        "required": [
          "base_url",
          "auth_mode",
          "username"
        ]
      },
      "return_schema": {
        "type": "object",
        "title": "ProxmoxConnectionRecord",
        "x-sdl": "entity",
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "title"
        ]
      },
      "event": "connection.created",
      "background": false,
      "long_running": false,
      "scopes": []
    },
    {
      "name": "list_proxmox_connections",
      "description": "List saved Proxmox connections for the current user.",
      "action_type": "read",
      "chain_callable": true,
